# Copy to .env:  cp .env.example .env
# Values here target running the API locally (venv) against the dockerized Postgres.
# Inside Docker Compose, DATABASE_URL and REDIS_URL are overridden with service hostnames.
# A blank value means "not set". Never commit .env — it holds real keys.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (used by the postgres container and by the API inside Docker) ----
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_DB=flowforge

# --- Host ports (change if something on your machine already uses them) -------
# 5433 rather than 5432 so a locally installed Postgres doesn't clash.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- API ---------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5433/flowforge
REDIS_URL=redis://localhost:6379/0

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Required. Encrypts stored credentials (users' API keys / app passwords) at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, prepend a new key: NEW_KEY,OLD_KEY (the first encrypts, all decrypt).
# Losing it makes stored credentials unreadable; users would have to reconnect.
ENCRYPTION_KEY=

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per-IP limit on /api/auth/login, /register, and /refresh.
AUTH_RATE_LIMIT=10/minute

# --- Deployments (POST /api/v1/deployments/{id}/run) ------------------------------
# Per-deployment limits (every caller of one endpoint shares them), counted after the
# API key is checked: runs, and polls of GET /api/v1/deployments/{id}/executions/{id}.
DEPLOYMENT_RUN_RATE_LIMIT=30/minute
DEPLOYMENT_STATUS_RATE_LIMIT=240/minute
# ?wait=true waits this long by default (?timeout= up to the maximum), then answers 202.
DEPLOYMENT_WAIT_TIMEOUT_SECONDS=30
DEPLOYMENT_MAX_WAIT_SECONDS=120

# --- LLM providers (server-wide defaults) ---------------------------------------
# A user's own key (POST /api/integrations/{provider}/connect) takes priority over these.
# A node whose provider has no key anywhere fails validation with "Authentication missing".
# *_MODEL values are optional; blank uses the built-in default shown.

# Google Gemini — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite (about 500 free requests/day when checked).
# gemini-3.8-flash is stronger but was limited to 20 free requests/day.
GEMINI_MODEL=
# Default: gemini-embedding-2
GEMINI_EMBEDDING_MODEL=

# Groq — free key: https://console.groq.com/keys
GROQ_API_KEY=
# Default: openai/gpt-oss-20b. Model access varies per account;
# POST /api/integrations/groq/test lists what your key can use.
GROQ_MODEL=

# OpenRouter — free key: https://openrouter.ai/settings/keys (use models ending in ":free")
OPENROUTER_API_KEY=
# Default: openrouter/free (routes to an available free model)
OPENROUTER_MODEL=

# Mistral — free "Experiment" plan (needs phone verification): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Default: ministral-8b-latest (free-tier accounts can get 0 requests/min on mistral-small-latest)
MISTRAL_MODEL=

# Cerebras — free tier (5 requests/min, 1M tokens/day when checked): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Default: qwen-3.8-27b (gpt-oss-120b is the other free model)
CEREBRAS_MODEL=

# GitHub Models is not offered: GitHub retired it on 2026-07-30. Point the Custom provider
# at any other OpenAI-compatible endpoint instead.

# Custom (any OpenAI-compatible endpoint), e.g. https://api.together.xyz/v1. The base URL
# must be a public address (the SSRF guard; HTTP_ALLOW_PRIVATE_NETWORKS=true lifts that for
# local development). The key is optional; the model is required.
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=

# Ollama — local models, no key: https://ollama.com/download, then `ollama pull llama3.2`
# host.docker.internal reaches your machine from the API container (Linux included, via
# extra_hosts). For a venv run of the API use http://localhost:11434/v1 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Default: llama3.2
OLLAMA_MODEL=
# Default: nomic-embed-text
OLLAMA_EMBEDDING_MODEL=

# Paid providers (optional). OpenAI uses the same OpenAI-compatible adapter as Groq/OpenRouter/Ollama.
OPENAI_API_KEY=
# Default: gpt-4.1-mini
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Default: claude-opus-5
ANTHROPIC_MODEL=

# --- Speech to Text ----------------------------------------------------------------
# Groq's Whisper uses GROQ_API_KEY (free: 20 requests/min, 2,000/day, 7,200 audio
# seconds/hour, 25 MB per file when checked; longer files are split automatically).
# Default: whisper-large-v3-turbo. Translation to English uses whisper-large-v3.
GROQ_WHISPER_MODEL=
GROQ_WHISPER_TRANSLATE_MODEL=
# Upload limit per request in MB: 25 on the free tier, 100 on the developer tier.
GROQ_WHISPER_MAX_FILE_MB=25
# Local faster-whisper (no key, CPU): tiny | base | small | medium | large-v3 | turbo.
# Downloaded on first use into WHISPER_MODELS_DIR (Docker: the whisper_models volume).
FASTER_WHISPER_MODEL=base
# int8 is fastest on CPU; float32 is slightly more accurate.
FASTER_WHISPER_COMPUTE_TYPE=int8
# WHISPER_MODELS_DIR=

# --- Web Search ---------------------------------------------------------------------
# DuckDuckGo needs no key. Tavily (free: 1,000 credits/month): https://app.tavily.com
# With a key, searches fall back to Tavily when DuckDuckGo fails or rate limits (and back).
TAVILY_API_KEY=

# --- Workspace apps: Notion and Airtable (README "Notion and Airtable") ---------------
# Notion internal integration token (ntn_...): notion.so/profile/integrations. Share each
# database with the integration (••• > Connections).
NOTION_API_KEY=
# Airtable personal access token (pat...): airtable.com/create/tokens, scopes
# data.records:read and data.records:write, with the bases it may use.
AIRTABLE_API_KEY=
# Only for the live tests (pytest -m live): a database / table they may add rows to.
# NOTION_TEST_DATABASE_ID=
# AIRTABLE_TEST_BASE_ID=
# AIRTABLE_TEST_TABLE=
# AIRTABLE_TEST_FIELD=Name

# Retries for HTTP 429 / 5xx / network errors (exponential backoff; a provider's
# Retry-After is honoured up to the max delay). Free-tier limits change, so none are hardcoded.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Email: Gmail over SMTP (send) + IMAP (read) --------------------------------
# SMTP_PASSWORD must be a 16-character Google App Password, not your normal password.
# See README "Gmail: create an App Password". The same account is used for IMAP reads.
SMTP_USER=
SMTP_PASSWORD=
# Optional display name, e.g. FlowForge
SMTP_FROM_NAME=
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = implicit TLS
SMTP_PORT=587
# auto | starttls | ssl
SMTP_SECURITY=auto
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Notifications: Telegram and Discord (server-wide defaults) -------------------
# Users can store their own under Integrations (encrypted); theirs wins.
# Telegram: create a bot with @BotFather (/newbot) and paste its token. Message your bot,
# then read message.chat.id from https://api.telegram.org/bot<token>/getUpdates.
# The chat id is where Telegram nodes send when they don't name a chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Max seconds a single node may run.
WORKFLOW_NODE_TIMEOUT_SECONDS=120

# --- Async execution (Celery workers) ------------------------------------------
# Broker and result backend; blank = REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# A whole run is stopped and marked failed after this many seconds.
EXECUTION_TIME_LIMIT_SECONDS=1800
# Retries for infrastructure errors (DB/broker down) before a run starts. Node failures
# are never retried.
CELERY_TASK_MAX_RETRIES=3
# Running executions heartbeat this often; silent for EXECUTION_STALE_AFTER_SECONDS means
# the worker died and the run is marked failed (checked every EXECUTION_RECOVERY_INTERVAL_SECONDS).
EXECUTION_HEARTBEAT_SECONDS=5
EXECUTION_STALE_AFTER_SECONDS=30
EXECUTION_RECOVERY_INTERVAL_SECONDS=15
# Pending runs no worker picks up within this long are marked failed.
EXECUTION_PENDING_TIMEOUT_SECONDS=3600
# POST /stop waits this long for the worker to confirm (then answers 202).
EXECUTION_STOP_WAIT_SECONDS=5
EXECUTION_STOP_POLL_SECONDS=0.25
# Compose only: processes per worker container, per queue (scale containers with
# `docker compose up -d --scale worker-ocr=3`).
WORKER_DEFAULT_CONCURRENCY=4
WORKER_LLM_CONCURRENCY=8
WORKER_OCR_CONCURRENCY=2
WORKER_AUDIO_CONCURRENCY=2
# CPU threads per Tesseract process on worker-ocr (1: parallelism comes from concurrency).
OCR_THREADS_PER_TASK=1
# CPU threads per local faster-whisper transcription on worker-audio.
AUDIO_THREADS_PER_TASK=2

# --- Triggers (schedules, email, webhook) ------------------------------------------
# The `beat` service ticks every minute. A schedule whose fire time is older than this when
# a tick sees it (beat or the workers were down) is skipped rather than run late.
TRIGGER_MISFIRE_GRACE_SECONDS=3600
# Email triggers check the mailbox at most this often (minutes).
EMAIL_TRIGGER_MIN_POLL_MINUTES=1
# The longest one mailbox check may hold its lock (a crashed poller frees it after this).
EMAIL_POLL_LOCK_SECONDS=300

# --- Uploaded files and the HTTP Request node ---------------------------------------
# Upload size limit (POST /api/files). The bytes live in the `files_data` volume (Docker)
# or FILES_DIR (local runs; default apps/api/.data/files).
MAX_UPLOAD_MB=25
# Audio and video uploads (for Speech to Text) have their own, larger limit.
MAX_MEDIA_UPLOAD_MB=500
# FILES_DIR=
# The HTTP Request node refuses private/internal addresses (localhost, 10/8, 172.16/12,
# 192.168/16, link-local, Docker service names, ...). true allows them: local development only.
HTTP_ALLOW_PRIVATE_NETWORKS=false

# --- WebSocket (live execution events) -------------------------------------------
WS_HEARTBEAT_SECONDS=15
WS_AUTH_TIMEOUT_SECONDS=10
WS_DB_CHECK_SECONDS=10

# --- Web ---------------------------------------------------------------------
# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telegram Command Center (the telegram-listener service uses TELEGRAM_BOT_TOKEN above).
# Requests per chat per minute, how long Confirm buttons work, how long the bot waits for a result.
TELEGRAM_RATE_LIMIT_PER_MINUTE=10
TELEGRAM_CONFIRM_SECONDS=300
TELEGRAM_RUN_WAIT_SECONDS=600

# Discord voice monitor (the discord-bot service; see README "Discord voice meetings").
# The bot asks TELEGRAM_CHAT_ID before it records anything.
DISCORD_BOT_TOKEN=
DISCORD_MONITOR_GUILD_ID=
DISCORD_MONITOR_CHANNEL_ID=
# Safety cap on one recording, shorter recordings aren't summarized, and the pipeline (by name) that does it.
DISCORD_RECORDING_MAX_MINUTES=90
DISCORD_MIN_RECORDING_SECONDS=30
DISCORD_MEETING_PIPELINE=Meeting Notes
# audio (default): Telegram gets the recording as an MP3. notes: the Meeting Notes pipeline summarizes it.
DISCORD_OUTPUT=audio
# node (default): the discord-recorder service (discord.js) records, the discord-bot service decides.
# pycord: discord-bot records by itself (py-cord 2.8 voice receive is unreliable).
DISCORD_RECORDER=node

# Flower (Celery dashboard, http://localhost:5555). Change the password if the port is ever exposed.
FLOWER_USER=admin
FLOWER_PASSWORD=flowforge
