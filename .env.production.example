# FlowForge AI: production environment (compose.prod.yaml). Copy to `.env` on the server and fill in.
# Every variable is explained in docs/HOSTING.md. Lines marked REQUIRED have no safe default; the stack
# refuses to start without them. Generate the secrets with:  sh scripts/gen-secrets.sh

# --- Your site ---------------------------------------------------------------------------------------
# REQUIRED. The domain Caddy serves, with DNS already pointing at this server (no https://, no slash).
DOMAIN=example.com
# REQUIRED. The URL browsers use for it. It becomes the web app's API address (baked in at build time) and
# the one allowed CORS origin. Changing it means rebuilding the web image.
PUBLIC_URL=https://example.com
# An email address Let's Encrypt can contact about certificate problems. Optional but recommended.
ACME_EMAIL=you@example.com
# Defaults to PUBLIC_URL. Comma-separated exact origins; never "*" (the API refuses to start with it).
# CORS_ORIGINS=https://example.com

# --- Secrets (REQUIRED) -------------------------------------------------------------------------------
# Signs login tokens and the session cookie. At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=
# A Fernet key. Encrypts the credentials users store (Integrations). LOSE IT AND THOSE CREDENTIALS ARE GONE;
# back it up somewhere safe. Rotate by listing the new key first, then the old: NEW,OLD.
ENCRYPTION_KEY=
# The database password (hex is safe; avoid characters that need URL-encoding: @ : / ? #).
POSTGRES_PASSWORD=
POSTGRES_USER=flowforge
POSTGRES_DB=flowforge

# --- Public demo mode (default off) --------------------------------------------------------------------
# On: every account except DEMO_OWNER_EMAIL is a visitor. Visitors use only the server's AI keys below
# (capped per account per day) and must connect their OWN Gmail/Discord/Telegram/Notion/Airtable; the
# owner's accounts are never lent. The Discord recorder and Telegram bot act for the owner only.
PUBLIC_DEMO=false
# REQUIRED when PUBLIC_DEMO=true: the registered email of the owner's account.
DEMO_OWNER_EMAIL=
DEMO_RUNS_PER_DAY=25
DEMO_TOKENS_PER_DAY=60000

# --- AI providers (the keys the demo shares with visitors, and your own default) -----------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
TAVILY_API_KEY=

# --- The owner's own accounts (never offered to visitors in demo mode) ---------------------------------
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTION_API_KEY=
AIRTABLE_API_KEY=

# --- Backups -------------------------------------------------------------------------------------------
# Where daily database dumps (and an archive of uploaded files) are written on the host.
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=14
BACKUP_FILES=true

# --- Optional: --profile monitoring (Flower) / --profile bots ------------------------------------------
FLOWER_USER=admin
FLOWER_PASSWORD=
# Telegram Command Center + Discord voice recorder (--profile bots)
DISCORD_BOT_TOKEN=
DISCORD_MONITOR_GUILD_ID=
DISCORD_MONITOR_CHANNEL_ID=

# --- Tuning (all optional) -----------------------------------------------------------------------------
# API_WORKERS=2
# WORKER_DEFAULT_CONCURRENCY=4
# WORKER_LLM_CONCURRENCY=8
# WORKER_OCR_CONCURRENCY=2
# WORKER_AUDIO_CONCURRENCY=2
# Ports Caddy publishes (80/443 normally; change only to try the stack on a laptop).
# HTTP_PORT=80
# HTTPS_PORT=443
# FLOWER_HOST_PORT=5555
