# Copy to .env:  cp .env.example .env
# Values here target running the API locally (venv) against the dockerized Postgres.
# Inside Docker Compose, DATABASE_URL and REDIS_URL are overridden with service hostnames.
# A blank value means "not set". Never commit .env — it holds real keys.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (used by the postgres container and by the API inside Docker) ----
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_DB=flowforge

# --- Host ports (change if something on your machine already uses them) -------
# 5433 rather than 5432 so a locally installed Postgres doesn't clash.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- API ---------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5433/flowforge
REDIS_URL=redis://localhost:6379/0

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Required. Encrypts stored credentials (users' API keys / app passwords) at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, prepend a new key: NEW_KEY,OLD_KEY (the first encrypts, all decrypt).
# Losing it makes stored credentials unreadable; users would have to reconnect.
ENCRYPTION_KEY=

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per-IP limit on /api/auth/login, /register, and /refresh.
AUTH_RATE_LIMIT=10/minute

# --- LLM providers (server-wide defaults) ---------------------------------------
# A user's own key (POST /api/integrations/{provider}/connect) takes priority over these.
# A node whose provider has no key anywhere fails validation with "Authentication missing".
# *_MODEL values are optional; blank uses the built-in default shown.

# Google Gemini — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite (about 500 free requests/day when checked).
# gemini-3.8-flash is stronger but was limited to 20 free requests/day.
GEMINI_MODEL=
# Default: gemini-embedding-2
GEMINI_EMBEDDING_MODEL=

# Groq — free key: https://console.groq.com/keys
GROQ_API_KEY=
# Default: openai/gpt-oss-20b. Model access varies per account;
# POST /api/integrations/groq/test lists what your key can use.
GROQ_MODEL=

# OpenRouter — free key: https://openrouter.ai/settings/keys (use models ending in ":free")
OPENROUTER_API_KEY=
# Default: openrouter/free (routes to an available free model)
OPENROUTER_MODEL=

# Ollama — local models, no key: https://ollama.com/download, then `ollama pull llama3.2`
# host.docker.internal reaches your machine from the API container (Linux included, via
# extra_hosts). For a venv run of the API use http://localhost:11434/v1 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Default: llama3.2
OLLAMA_MODEL=
# Default: nomic-embed-text
OLLAMA_EMBEDDING_MODEL=

# Paid providers (optional). OpenAI uses the same OpenAI-compatible adapter as Groq/OpenRouter/Ollama.
OPENAI_API_KEY=
# Default: gpt-4.1-mini
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Default: claude-opus-5
ANTHROPIC_MODEL=

# Retries for HTTP 429 / 5xx / network errors (exponential backoff; a provider's
# Retry-After is honoured up to the max delay). Free-tier limits change, so none are hardcoded.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Email: Gmail over SMTP (send) + IMAP (read) --------------------------------
# SMTP_PASSWORD must be a 16-character Google App Password, not your normal password.
# See README "Gmail: create an App Password". The same account is used for IMAP reads.
SMTP_USER=
SMTP_PASSWORD=
# Optional display name, e.g. FlowForge
SMTP_FROM_NAME=
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = implicit TLS
SMTP_PORT=587
# auto | starttls | ssl
SMTP_SECURITY=auto
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Max seconds a single node may run.
WORKFLOW_NODE_TIMEOUT_SECONDS=120

# --- Async execution (Celery workers) ------------------------------------------
# Broker and result backend; blank = REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# A whole run is stopped and marked failed after this many seconds.
EXECUTION_TIME_LIMIT_SECONDS=600
# Retries for infrastructure errors (DB/broker down) before a run starts. Node failures
# are never retried.
CELERY_TASK_MAX_RETRIES=3
# Running executions heartbeat this often; silent for EXECUTION_STALE_AFTER_SECONDS means
# the worker died and the run is marked failed (checked every EXECUTION_RECOVERY_INTERVAL_SECONDS).
EXECUTION_HEARTBEAT_SECONDS=5
EXECUTION_STALE_AFTER_SECONDS=30
EXECUTION_RECOVERY_INTERVAL_SECONDS=15
# Pending runs no worker picks up within this long are marked failed.
EXECUTION_PENDING_TIMEOUT_SECONDS=3600
# POST /stop waits this long for the worker to confirm (then answers 202).
EXECUTION_STOP_WAIT_SECONDS=5
EXECUTION_STOP_POLL_SECONDS=0.25
# Compose only: queues and processes of the `worker` service.
WORKER_QUEUES=default
WORKER_CONCURRENCY=4

# --- WebSocket (live execution events) -------------------------------------------
WS_HEARTBEAT_SECONDS=15
WS_AUTH_TIMEOUT_SECONDS=10
WS_DB_CHECK_SECONDS=10

# --- Web ---------------------------------------------------------------------
# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
